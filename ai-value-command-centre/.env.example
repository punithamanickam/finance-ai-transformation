# Copy to .env. Never commit real secrets.
# Session-token signing key (required outside a local demo): python -c "import secrets; print(secrets.token_hex(32))"
AVCC_SECRET_KEY=
# Password shared by the demo accounts (cfo@, fpa@, bu.supplychain@, bu.sales@meridian.example)
AVCC_DEMO_PASSWORD=demo
# SQLite by default; PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://avcc:avcc@localhost:5432/avcc
DATABASE_URL=
# LLM narrative: auto (Anthropic if a key is set, else offline) | anthropic | offline
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

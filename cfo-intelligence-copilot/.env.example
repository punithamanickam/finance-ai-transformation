# LLM provider: auto (use Anthropic if credentials exist, else offline) | anthropic | offline
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5
# Anthropic credentials (or run `ant auth login`). Never commit a real key.
ANTHROPIC_API_KEY=
# SEC EDGAR fair-access policy requires a descriptive User-Agent with a contact address
SEC_USER_AGENT="Your Name or Org your.email@example.com"
CFO_COMPANY="Microsoft Corporation"
CFO_CURRENT_FY=2026
